rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'gobburunana@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrapAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---

    function isValidInstituteConfig(data) {
      return data.centerName is string && data.centerName.size() >= 2 && data.centerName.size() <= 100 &&
             data.tagline is string && data.tagline.size() >= 2 && data.tagline.size() <= 180 &&
             data.directorName is string && data.directorName.size() >= 2 && data.directorName.size() <= 80 &&
             data.directorBio is string && data.directorBio.size() >= 2 && data.directorBio.size() <= 350 &&
             data.address is string && data.address.size() >= 5 && data.address.size() <= 300 &&
             (!('landmark' in data) || (data.landmark is string && data.landmark.size() <= 150)) &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
             data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
             data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
             data.mainPhone is string && data.mainPhone.size() >= 8 && data.mainPhone.size() <= 20 &&
             (!('altPhone1' in data) || (data.altPhone1 is string && data.altPhone1.size() <= 20)) &&
             (!('altPhone2' in data) || (data.altPhone2 is string && data.altPhone2.size() <= 20)) &&
             (!('altPhone3' in data) || (data.altPhone3 is string && data.altPhone3.size() <= 20)) &&
             data.batchTimings is string && data.batchTimings.size() >= 3 && data.batchTimings.size() <= 160 &&
             data.monthlyFeeInr is int && data.monthlyFeeInr >= 0 && data.monthlyFeeInr <= 500000 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCourse(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.subject in [
               'IIT_JEE', 'NEET', 'BITSAT', 'EAMCET', 'INTERMEDIATE', 'FOUNDATION',
               'PHYSICS', 'CHEMISTRY', 'MATHEMATICS', 'FULL_JEE'
             ] &&
             data.targetExam is string && data.targetExam.size() >= 2 && data.targetExam.size() <= 80 &&
             data.instructor is string && data.instructor.size() >= 2 && data.instructor.size() <= 80 &&
             data.schedule is string && data.schedule.size() >= 2 && data.schedule.size() <= 140 &&
             data.feeAmountInr is int && data.feeAmountInr >= 0 && data.feeAmountInr <= 500000 &&
             data.feeCycle in ['MONTHLY', 'QUARTERLY', 'FULL_COURSE'] &&
             data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 80 &&
             data.description is string && data.description.size() >= 2 && data.description.size() <= 600 &&
             data.published is bool &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudyMaterial(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
             data.subject in ['PHYSICS', 'CHEMISTRY', 'MATHEMATICS', 'BIOLOGY', 'GENERAL'] &&
             data.chapter is string && data.chapter.size() >= 1 && data.chapter.size() <= 100 &&
             data.materialType in ['DPP', 'NOTES', 'FORMULA_SHEET', 'MOCK_PAPER'] &&
             data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 1200 &&
             (!('resourceUrl' in data) || (data.resourceUrl is string && data.resourceUrl.size() <= 500)) &&
             data.published is bool &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 2 && data.body.size() <= 800 &&
             data.category in ['EXAM', 'SCHEDULE', 'ADMISSION', 'GENERAL', 'FEE'] &&
             data.pinned is bool &&
             data.published is bool &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDoubt(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.subject in ['PHYSICS', 'CHEMISTRY', 'MATHEMATICS', 'BIOLOGY', 'GENERAL'] &&
             data.question is string && data.question.size() >= 5 && data.question.size() <= 1000 &&
             data.status in ['OPEN', 'ANSWERED'] &&
             (!('answer' in data) || (data.answer is string && data.answer.size() <= 1500)) &&
             (!('answeredBy' in data) || (data.answeredBy is string && data.answeredBy.size() <= 100)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 25)) &&
             (!('targetYear' in data) || (data.targetYear is string && data.targetYear.size() <= 30)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidEnrollment(data) {
      return isValidId(data.courseId) &&
             data.courseTitle is string && data.courseTitle.size() >= 2 && data.courseTitle.size() <= 120 &&
             data.targetExam is string && data.targetExam.size() >= 2 && data.targetExam.size() <= 80 &&
             data.schedule is string && data.schedule.size() >= 2 && data.schedule.size() <= 140 &&
             data.feeAmountInr is int && data.feeAmountInr >= 0 && data.feeAmountInr <= 500000 &&
             data.status in ['ACTIVE', 'COMPLETED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAttendance(data) {
      return data.batchName is string && data.batchName.size() >= 1 && data.batchName.size() <= 120 &&
             data.dateLabel is string && data.dateLabel.size() >= 4 && data.dateLabel.size() <= 30 &&
             data.status in ['PRESENT', 'REMOTE_STUDY'] &&
             data.distanceMeters is int && data.distanceMeters >= 0 && data.distanceMeters <= 50000000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidMockTestScore(data) {
      return data.testName is string && data.testName.size() >= 2 && data.testName.size() <= 120 &&
             data.physicsScore is int && data.physicsScore >= -30 && data.physicsScore <= 180 &&
             data.chemistryScore is int && data.chemistryScore >= -30 && data.chemistryScore <= 180 &&
             data.mathScore is int && data.mathScore >= -30 && data.mathScore <= 360 &&
             data.maxScore is int && data.maxScore >= 1 && data.maxScore <= 720 &&
             data.dateLabel is string && data.dateLabel.size() >= 4 && data.dateLabel.size() <= 30 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- COLLECTION RULES ---

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && request.auth.uid == adminUid;
      allow list, write: if false;
    }

    // 1. Institute Config (Campus Location, Contact/WhatsApp Numbers, Director & Timings)
    match /institute_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId) && configId == 'main';
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(configId) &&
                       configId == 'main' &&
                       isValidInstituteConfig(incoming()) &&
                       incoming().keys().hasAll([
                         'centerName', 'tagline', 'directorName', 'directorBio',
                         'address', 'city', 'latitude', 'longitude',
                         'mainPhone', 'batchTimings', 'monthlyFeeInr', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'centerName', 'tagline', 'directorName', 'directorBio',
                         'address', 'landmark', 'city', 'latitude', 'longitude',
                         'mainPhone', 'altPhone1', 'altPhone2', 'altPhone3',
                         'batchTimings', 'monthlyFeeInr', 'updatedAt'
                       ]) &&
                       isAdmin();

      allow update: if isSignedIn() &&
                       isValidId(configId) &&
                       configId == 'main' &&
                       isValidInstituteConfig(incoming()) &&
                       incoming().keys().hasOnly([
                         'centerName', 'tagline', 'directorName', 'directorBio',
                         'address', 'landmark', 'city', 'latitude', 'longitude',
                         'mainPhone', 'altPhone1', 'altPhone2', 'altPhone3',
                         'batchTimings', 'monthlyFeeInr', 'updatedAt'
                       ]) &&
                       isAdmin();

      allow delete: if false;
    }

    // 2. Courses & Batches
    match /courses/{courseId} {
      allow get: if isSignedIn() && isValidId(courseId) && (existing().published == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.published == true || isBootstrapAdmin());

      allow create: if isSignedIn() &&
                       isValidId(courseId) &&
                       isValidCourse(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().keys().hasAll([
                         'title', 'subject', 'targetExam', 'instructor', 'schedule',
                         'feeAmountInr', 'feeCycle', 'roomName', 'description',
                         'published', 'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'subject', 'targetExam', 'instructor', 'schedule',
                         'feeAmountInr', 'feeCycle', 'roomName', 'description',
                         'published', 'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       isAdmin();

      allow update: if isSignedIn() &&
                       isValidId(courseId) &&
                       isValidCourse(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       isAdmin() &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'subject', 'targetExam', 'instructor', 'schedule',
                         'feeAmountInr', 'feeCycle', 'roomName', 'description',
                         'published', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(courseId) && isAdmin();
    }

    // 3. Study Materials & DPPs
    match /study_materials/{materialId} {
      allow get: if isSignedIn() && isValidId(materialId) && (existing().published == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.published == true || isBootstrapAdmin());

      allow create: if isSignedIn() &&
                       isValidId(materialId) &&
                       isValidStudyMaterial(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().keys().hasAll([
                         'title', 'subject', 'chapter', 'materialType',
                         'summary', 'published', 'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'subject', 'chapter', 'materialType',
                         'summary', 'resourceUrl', 'published', 'createdBy',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isAdmin();

      allow update: if isSignedIn() &&
                       isValidId(materialId) &&
                       isValidStudyMaterial(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       isAdmin() &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'subject', 'chapter', 'materialType',
                         'summary', 'resourceUrl', 'published', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(materialId) && isAdmin();
    }

    // 4. Announcements / Updates
    match /announcements/{announcementId} {
      allow get: if isSignedIn() && isValidId(announcementId) && (existing().published == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.published == true || isBootstrapAdmin());

      allow create: if isSignedIn() &&
                       isValidId(announcementId) &&
                       isValidAnnouncement(incoming()) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().keys().hasAll([
                         'title', 'body', 'category', 'pinned',
                         'published', 'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'body', 'category', 'pinned',
                         'published', 'createdBy', 'createdAt', 'updatedAt'
                       ]) &&
                       isAdmin();

      allow update: if isSignedIn() &&
                       isValidId(announcementId) &&
                       isValidAnnouncement(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       isAdmin() &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'body', 'category', 'pinned', 'published', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(announcementId) && isAdmin();
    }

    // 5. Student Doubts & Faculty Resolution
    match /doubts/{doubtId} {
      allow get: if isSignedIn() && isValidId(doubtId) &&
                    (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isBootstrapAdmin());

      allow create: if isSignedIn() &&
                       isValidId(doubtId) &&
                       isValidDoubt(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'OPEN' &&
                       !('answer' in incoming()) &&
                       !('answeredBy' in incoming()) &&
                       incoming().keys().hasAll([
                         'userId', 'studentName', 'subject', 'question',
                         'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'studentName', 'subject', 'question',
                         'status', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidId(doubtId) &&
                       isValidDoubt(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['answer', 'answeredBy', 'status', 'updatedAt'])) ||
                         (existing().userId == request.auth.uid &&
                          existing().status == 'OPEN' &&
                          incoming().status == 'OPEN' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['subject', 'question', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(doubtId) &&
                       (existing().userId == request.auth.uid || isAdmin());
    }

    // 6. User Profiles (PII Isolated) & User Subcollections
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrapAdmin();

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'phone', 'targetYear', 'createdAt', 'updatedAt']);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'targetYear', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // 6a. Student Enrollments
      match /enrollments/{enrollmentId} {
        allow get: if isSignedIn() && isValidId(enrollmentId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (isOwner(userId) || isBootstrapAdmin());

        allow create: if isOwner(userId) &&
                         isValidId(enrollmentId) &&
                         isValidEnrollment(incoming()) &&
                         incoming().status == 'ACTIVE' &&
                         incoming().keys().hasAll([
                           'courseId', 'courseTitle', 'targetExam', 'schedule',
                           'feeAmountInr', 'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'courseId', 'courseTitle', 'targetExam', 'schedule',
                           'feeAmountInr', 'status', 'createdAt', 'updatedAt'
                         ]) &&
                         exists(/databases/$(database)/documents/courses/$(incoming().courseId));

        allow update: if (isOwner(userId) || isAdmin()) &&
                         isValidId(enrollmentId) &&
                         isValidEnrollment(incoming()) &&
                         incoming().courseId == existing().courseId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

        allow delete: if isValidId(enrollmentId) && (isOwner(userId) || isAdmin());
      }

      // 6b. Campus Attendance Check-Ins
      match /attendance/{attendanceId} {
        allow get: if isSignedIn() && isValidId(attendanceId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (isOwner(userId) || isBootstrapAdmin());

        allow create: if isOwner(userId) &&
                         isValidId(attendanceId) &&
                         isValidAttendance(incoming()) &&
                         incoming().keys().hasAll([
                           'batchName', 'dateLabel', 'status', 'distanceMeters', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'batchName', 'dateLabel', 'status', 'distanceMeters', 'createdAt'
                         ]);

        allow update: if false;
        allow delete: if isValidId(attendanceId) && (isOwner(userId) || isAdmin());
      }

      // 6c. Mock Test Scores
      match /test_scores/{scoreId} {
        allow get: if isSignedIn() && isValidId(scoreId) && (isOwner(userId) || isAdmin());
        allow list: if isSignedIn() && (isOwner(userId) || isBootstrapAdmin());

        allow create: if isOwner(userId) &&
                         isValidId(scoreId) &&
                         isValidMockTestScore(incoming()) &&
                         incoming().keys().hasAll([
                           'testName', 'physicsScore', 'chemistryScore',
                           'mathScore', 'maxScore', 'dateLabel', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'testName', 'physicsScore', 'chemistryScore',
                           'mathScore', 'maxScore', 'dateLabel', 'createdAt'
                         ]);

        allow update: if false;
        allow delete: if isValidId(scoreId) && (isOwner(userId) || isAdmin());
      }
    }
  }
}
